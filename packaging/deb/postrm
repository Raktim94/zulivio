#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "zulivio: your data stays in Docker volumes (zulivio_pg_data, zulivio_uploads_data, zulivio_secrets_data) and your settings in /etc/zulivio/zulivio.env. Remove them only if you are sure." >&2
fi
exit 0
