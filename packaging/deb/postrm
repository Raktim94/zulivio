#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "zulivio: your data stays in Docker volumes (zulivio_pg_data, zulivio_uploads_data, zulivio_secrets_data) and your settings and generated passwords in /etc/zulivio/zulivio.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name zulivio down -v ; sudo rm -rf /etc/zulivio" >&2
fi
exit 0
