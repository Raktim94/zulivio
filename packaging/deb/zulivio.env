# Zulivio settings. Restart after editing: sudo systemctl restart zulivio
POSTGRES_PASSWORD=@SECRET@
HOST_PORT=3100
# Origin(s) the browser uses to open the app, comma-separated. Add your server's LAN address or domain
# (with http:// or https://), for example: http://localhost:3100,http://192.168.1.50:3100
FRONTEND_ORIGIN=http://localhost:3100
# Set true only behind real HTTPS.
COOKIE_SECURE=false
# Set true after you have created your organization to close self-service signup.
BOOTSTRAP_DISABLED=false
