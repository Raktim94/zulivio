generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER_OWNER
  COMPANY_ADMIN
  SALES_HEAD
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  ON_LEAVE
  SEPARATED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  FOLLOW_UP
  BLOCKED
  COMPLETED
  CANCELED
}

enum AttendanceEventType {
  WORKING
  ON_BREAK
  LOGGED_OUT
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees      Employee[]
  assignments    Assignment[]
  workSessions   WorkSession[]
  documents      KnowledgeDocument[]
  tips           Tip[]
  auditEvents    AuditEvent[]
  leads          Lead[]
  pipelines      Pipeline[]
  opportunities  Opportunity[]
  assignmentRules AssignmentRule[]
  qualityAuditDefinitions QualityAuditDefinition[]
  qualityAuditResults     QualityAuditResult[]
  workflowDefinitions     WorkflowDefinition[]
  workflowRuns            WorkflowRun[]
  leadActivities          LeadActivity[]
  leadFollowUps           LeadFollowUp[]
  leadScoreConfig         LeadScoreConfig?

  @@map("organizations")
}

model Employee {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  employeeNumber   String
  fullName         String
  email            String
  passwordHash     String
  role             Role              @default(EMPLOYEE)
  department       String?
  employmentStatus EmploymentStatus  @default(ACTIVE)
  mustChangePassword Boolean         @default(true)
  managerId        String?
  manager          Employee?         @relation("EmployeeManager", fields: [managerId], references: [id])
  reports          Employee[]        @relation("EmployeeManager")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  separatedAt      DateTime?

  sessions             Session[]
  apiKeys              ApiKey[]
  assignmentsOwned     Assignment[]        @relation("AssignmentOwner")
  assignmentsCreated   Assignment[]        @relation("AssignmentCreatedBy")
  workSessions         WorkSession[]
  trainingResults      TrainingResult[]
  tipAcknowledgements  TipAcknowledgement[]
  leadsOwned           Lead[]              @relation("LeadOwner")
  leadsCreated         Lead[]              @relation("LeadCreatedBy")
  opportunitiesOwned   Opportunity[]       @relation("OpportunityOwner")
  opportunitiesCreated Opportunity[]       @relation("OpportunityCreatedBy")
  qualityAuditsAsSubject  QualityAuditResult[] @relation("QualityAuditSubject")
  qualityAuditsAsReviewer QualityAuditResult[] @relation("QualityAuditReviewer")
  workflowRuns            WorkflowRun[]
  leadActivities          LeadActivity[]       @relation("LeadActivityActor")
  followUpsAssigned       LeadFollowUp[]       @relation("FollowUpAssignee")
  followUpsCreated        LeadFollowUp[]       @relation("FollowUpCreatedBy")

  @@unique([organizationId, employeeNumber])
  // Global, not per-org: login and bootstrap both resolve an employee by
  // email alone (no organizationId in that lookup), so email has always
  // been a de facto global identifier — this makes the DB actually enforce
  // that instead of relying only on the app-layer check in
  // employees.service.ts. See SECURITY_AUDIT_REPORT.md finding #9.
  @@unique([email])
  @@index([organizationId, employmentStatus])
  @@map("employees")
}

model Session {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  @@index([employeeId])
  @@map("sessions")
}

// Personal access tokens, primarily for the MCP server (mcp/) so an AI
// client (Claude, ChatGPT, etc.) can call the API as a specific employee —
// same tokenHash-lookup pattern as Session above (random token shown once
// at creation, only its SHA-256 hash stored). A key carries no permissions
// of its own: AuthGuard resolves it to its owning employee, so every
// existing role/RBAC/scope check applies unchanged to key-authenticated
// requests, exactly as if that employee were logged in. lastFour is
// display-only (e.g. "zlv_••••ab12"), never used for lookup.
model ApiKey {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  name       String
  tokenHash  String    @unique
  lastFour   String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([employeeId])
  @@map("api_keys")
}

model Assignment {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  assignmentNumber Int
  title          String
  description    String?
  status         AssignmentStatus  @default(ASSIGNED)
  priority       String            @default("normal")
  ownerId        String?
  owner          Employee?         @relation("AssignmentOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      Employee          @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  dueAt          DateTime?
  outcome        String?
  outcomeNotes   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?

  events AssignmentEvent[]

  @@unique([organizationId, assignmentNumber])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@map("assignments")
}

model AssignmentEvent {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  fromStatus   AssignmentStatus?
  toStatus     AssignmentStatus
  actorId      String
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([assignmentId])
  @@map("assignment_events")
}

model WorkSession {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  startedAt      DateTime     @default(now())
  endedAt        DateTime?

  breaks Break[]

  @@index([organizationId, employeeId, startedAt])
  @@map("work_sessions")
}

model Break {
  id            String       @id @default(uuid())
  workSessionId String
  workSession   WorkSession  @relation(fields: [workSessionId], references: [id])
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  reason        String?

  @@index([workSessionId])
  @@map("breaks")
}

model KnowledgeDocument {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  title          String
  description    String?
  category       String?
  status         DocumentStatus @default(DRAFT)
  storageKey     String
  fileName       String
  mimeType       String
  sizeBytes      Int
  version        Int            @default(1)
  ownerId        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  trainingAssignments TrainingAssignment[]

  @@index([organizationId, status])
  @@map("knowledge_documents")
}

model TrainingAssignment {
  id         String            @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id])
  targetRole Role?
  targetEmployeeId String?
  dueAt      DateTime?
  createdAt  DateTime          @default(now())

  results TrainingResult[]

  @@map("training_assignments")
}

model TrainingResult {
  id                   String              @id @default(uuid())
  trainingAssignmentId String
  trainingAssignment   TrainingAssignment  @relation(fields: [trainingAssignmentId], references: [id])
  employeeId           String
  employee             Employee            @relation(fields: [employeeId], references: [id])
  acknowledgedAt       DateTime?
  documentVersion      Int

  @@unique([trainingAssignmentId, employeeId])
  @@map("training_results")
}

model Tip {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  body           String
  linkedDocumentId String?
  targetRole     Role?
  targetDepartment String?
  publishAt      DateTime     @default(now())
  createdById    String
  createdAt      DateTime     @default(now())

  acknowledgements TipAcknowledgement[]

  @@index([organizationId, publishAt])
  @@map("tips")
}

model TipAcknowledgement {
  id         String   @id @default(uuid())
  tipId      String
  tip        Tip      @relation(fields: [tipId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  acknowledgedAt DateTime @default(now())

  @@unique([tipId, employeeId])
  @@map("tip_acknowledgements")
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

enum BackupStatus {
  PENDING
  UPLOADING
  VERIFIED
  FAILED
}

// Instance-wide, not organization-scoped: a backup is a full pg_dump of
// the whole database (every org sharing this instance) plus the uploads
// volume, so it has no single organizationId to attach to.
model BackupRecord {
  id          String       @id @default(uuid())
  status      BackupStatus @default(PENDING)
  dbKey       String?
  uploadsKey  String?
  sizeBytes   Int?
  sha256      String?
  // "schedule" for the automatic 3-day job, or the triggering employee's id.
  triggeredBy String
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  error       String?

  @@index([status, completedAt])
  @@map("backup_records")
}

// Singleton row (id is always the literal "singleton") holding S3 backup
// credentials entered from Settings, so the app is self-contained without
// needing env vars or CasaOS's config UI. Instance-wide, like BackupRecord.
// secretAccessKey is envelope-encrypted at rest (FieldEncryptionService,
// AES-256-GCM, key from FIELD_ENCRYPTION_KEY) — see SECURITY_AUDIT_REPORT.md
// finding #10. accessKeyId stays plaintext (an identifier, not a secret,
// same treatment AWS gives it) and is still masked before ever leaving the
// API. Settable only by the Master Owner.
model BackupConfig {
  id              String   @id @default("singleton")
  endpoint        String
  bucket          String
  accessKeyId     String
  secretAccessKey String
  region          String   @default("auto")
  intervalDays    Int      @default(3)
  retainCount     Int      @default(2)
  updatedById     String
  updatedAt       DateTime @updatedAt

  @@map("backup_config")
}

// Singleton row (id is always "singleton") holding the Google service-account
// credentials entered from Settings, mirroring BackupConfig — the app stays
// self-contained without needing env vars or CasaOS's config UI. privateKey
// is envelope-encrypted at rest (FieldEncryptionService, AES-256-GCM, key
// from FIELD_ENCRYPTION_KEY), same as BackupConfig.secretAccessKey — see
// SECURITY_AUDIT_REPORT.md finding #10, and is never returned by the API
// (clientEmail is — it's an identifier, not a secret, shown in Settings to
// confirm which service account is connected). Settable only by the Master
// Owner.
model GoogleSheetsConfig {
  id          String   @id @default("singleton")
  clientEmail String
  privateKey  String
  updatedById String
  updatedAt   DateTime @updatedAt

  @@map("google_sheets_config")
}

// Coarse lifecycle status. Deliberately unchanged by the telecalling CRM
// work: an existing live integration (Submify) creates leads through
// POST /api/v1/leads and reads this enum back, and the granular
// telecalling progression (New → Contacted → Connected → Interested →
// Qualified → Meeting Booked → Proposal Sent → Negotiation → Won) is
// modelled on the configurable PipelineStage rows instead, with each stage
// deriving one of these five values. Never remove or rename a member here.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Granular loss reasons for a lead. LeadStatus only has the single coarse
// DISQUALIFIED value, which can't answer "why did we lose this?" in a
// report — this records that alongside it rather than fragmenting the
// status enum every existing consumer depends on.
enum LeadLossReason {
  NOT_INTERESTED
  NO_BUDGET
  WRONG_NUMBER
  DUPLICATE
  COMPETITOR
  NOT_NOW
  LOST
}

enum PurchaseIntent {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fullName       String
  email          String?
  phone          String?
  company        String?
  source         String?
  status         LeadStatus   @default(NEW)
  ownerId        String?
  owner          Employee?    @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      Employee     @relation("LeadCreatedBy", fields: [createdById], references: [id])
  notes          String?
  territory      String?
  respondBySlaAt DateTime?
  firstRespondedAt DateTime?
  convertedOpportunityId String?  @unique
  convertedOpportunity   Opportunity? @relation("LeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // --- Telecalling CRM additions (all optional/defaulted, so every
  // existing row and every existing API caller keeps working unchanged) ---

  // Where this lead sits on the configurable telecalling board. Reuses the
  // existing Pipeline/PipelineStage models (kind = LEAD) rather than a
  // second, parallel stage system.
  pipelineId     String?
  pipeline       Pipeline?      @relation("LeadPipeline", fields: [pipelineId], references: [id])
  stageId        String?
  stage          PipelineStage? @relation("LeadStage", fields: [stageId], references: [id])
  stageChangedAt DateTime?

  jobTitle        String?
  website         String?
  campaign        String?
  tags            String[]     @default([])
  priority        LeadPriority @default(NORMAL)
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  callCount       Int          @default(0)

  lossReason LeadLossReason?
  lossNotes  String?

  // Qualification. Scored into `score` by LeadScoringService using the
  // org's LeadScoreConfig weights — never a hardcoded formula.
  budgetMinor       Int?
  timelineDays      Int?
  isDecisionMaker   Boolean?
  requirement       String?
  requirementUrgent Boolean?
  businessType      String?
  existingSolution  String?
  purchaseIntent    PurchaseIntent?
  goodBusinessFit   Boolean?
  score             Int             @default(0)
  qualifiedAt       DateTime?

  // Arbitrary source-data columns that don't have a dedicated field of
  // their own (e.g. a scraped-lead CSV's rating/category/outreach_angle).
  // Keyed by the original CSV header, normalized to snake_case; values are
  // always strings as they arrive from CSV/Sheets import. Never a home for
  // anything that already has a real column above — the importer only
  // populates this with columns it doesn't recognize.
  customFields Json @default("{}")

  opportunities  Opportunity[] @relation("OpportunityFromLead")
  activities     LeadActivity[]
  followUps      LeadFollowUp[]

  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, stageId])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, score])
  @@map("leads")
}

// Distinguishes the deal board (opportunities, the pre-existing use) from
// the telecalling lead board added by the CRM work. Defaults to
// OPPORTUNITY so every existing row keeps its meaning, and
// GET /api/v1/pipelines still returns only OPPORTUNITY pipelines unless a
// kind is asked for — the web pipeline page takes pipelines[0], so leaking
// a lead pipeline into that list would silently break it.
enum PipelineKind {
  OPPORTUNITY
  LEAD
}

// Single-tap call outcome. CONNECTED/NOT_CONNECTED splits the disposition
// list into the two groups a telecaller actually picks between.
enum CallOutcome {
  CONNECTED
  NOT_CONNECTED
}

enum CallDisposition {
  // CONNECTED
  INTERESTED
  QUALIFIED
  MEETING_BOOKED
  CALLBACK
  PROPOSAL_REQUESTED
  NOT_INTERESTED
  NO_BUDGET
  COMPETITOR
  WRONG_PERSON
  // NOT_CONNECTED
  NO_ANSWER
  BUSY
  SWITCHED_OFF
  INVALID_NUMBER
  OUT_OF_COVERAGE
}

enum LeadActivityType {
  CALL
  NOTE
  MESSAGE
  MEETING
  STAGE_CHANGE
  STATUS_CHANGE
  QUALIFICATION_UPDATED
  ASSIGNMENT_CHANGED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_RESCHEDULED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELED
}

// One chronological entry on a lead's timeline — a call (with duration and
// disposition), a note, a stage change, a scheduled follow-up, and so on.
// Append-only: entries are never edited or deleted, so the timeline stays a
// truthful record of what happened.
model LeadActivity {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id])
  type           LeadActivityType
  actorId        String
  actor          Employee         @relation("LeadActivityActor", fields: [actorId], references: [id])
  body           String?
  // Type-specific detail, e.g. { fromStageId, toStageId } for STAGE_CHANGE
  // or { scoreBefore, scoreAfter } for QUALIFICATION_UPDATED.
  metadata       Json?
  callOutcome         CallOutcome?
  callDisposition     CallDisposition?
  callDurationSeconds Int?
  createdAt      DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([organizationId, actorId, createdAt])
  @@index([organizationId, type, createdAt])
  @@map("lead_activities")
}

// A real, due-dated follow-up record. Before this, "follow-up" existed only
// as an AssignmentStatus value on the unrelated Assignment model, which
// carried no due date of its own and couldn't answer "what is overdue right
// now" for a telecaller.
model LeadFollowUp {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id])
  assigneeId     String
  assignee       Employee       @relation("FollowUpAssignee", fields: [assigneeId], references: [id])
  createdById    String
  createdBy      Employee       @relation("FollowUpCreatedBy", fields: [createdById], references: [id])
  dueAt          DateTime
  note           String?
  status         FollowUpStatus @default(PENDING)
  outcome        String?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, assigneeId, status, dueAt])
  @@index([leadId, dueAt])
  @@map("lead_follow_ups")
}

// Per-organization lead-scoring weights. Deliberately a table rather than
// constants in code: the brief's numbers (budget +25, decision maker +20,
// …) are a starting point every sales org tunes, and hardcoding them would
// mean a redeploy to change one. One row per organization, created lazily
// with the defaults below on first use.
model LeadScoreConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])

  budgetAvailableWeight   Int @default(25)
  decisionMakerWeight     Int @default(20)
  urgentRequirementWeight Int @default(20)
  clearRequirementWeight  Int @default(15)
  shortTimelineWeight     Int @default(10)
  goodBusinessFitWeight   Int @default(10)

  /// A timelineDays value strictly below this counts as a short timeline.
  shortTimelineDays Int @default(30)
  /// score >= hotThreshold is HOT; >= warmThreshold is WARM; else COLD.
  hotThreshold      Int @default(80)
  warmThreshold     Int @default(50)

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("lead_score_configs")
}

model Pipeline {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  isDefault      Boolean        @default(false)
  kind           PipelineKind   @default(OPPORTUNITY)
  createdAt      DateTime       @default(now())

  stages         PipelineStage[]
  opportunities  Opportunity[]
  leads          Lead[]         @relation("LeadPipeline")

  @@index([organizationId, kind])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id])
  name        String
  sortOrder   Int
  probability Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)

  opportunities Opportunity[]
  leads         Lead[]   @relation("LeadStage")

  @@index([pipelineId, sortOrder])
  @@map("pipeline_stages")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum ForecastCategory {
  PIPELINE
  BEST_CASE
  COMMITTED
  OMITTED
}

model Opportunity {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  pipelineId     String
  pipeline       Pipeline          @relation(fields: [pipelineId], references: [id])
  stageId        String
  stage          PipelineStage     @relation(fields: [stageId], references: [id])
  title          String
  company        String?
  amountMinor    Int               @default(0)
  currency       String            @default("INR")
  leadId         String?
  fromLead       Lead?             @relation("OpportunityFromLead", fields: [leadId], references: [id])
  ownerId        String?
  owner          Employee?         @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      Employee          @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  expectedCloseDate DateTime?
  status         OpportunityStatus @default(OPEN)
  lossReason     String?
  forecastCategory ForecastCategory @default(PIPELINE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  stageChangedAt DateTime          @default(now())

  convertedFromLead Lead? @relation("LeadConvertedOpportunity")
  events         OpportunityEvent[]
  forecastAdjustments ForecastAdjustment[]

  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, stageId])
  @@map("opportunities")
}

model OpportunityEvent {
  id            String       @id @default(uuid())
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id])
  fromStageId   String?
  toStageId     String
  actorId       String
  reason        String?
  createdAt     DateTime     @default(now())

  @@index([opportunityId])
  @@map("opportunity_events")
}

model ForecastAdjustment {
  id                  String      @id @default(uuid())
  organizationId      String
  opportunityId       String
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id])
  actorId             String
  previousCategory    ForecastCategory
  newCategory         ForecastCategory
  previousAmountMinor Int
  newAmountMinor      Int
  reason              String?
  createdAt           DateTime    @default(now())

  @@index([organizationId, opportunityId])
  @@map("forecast_adjustments")
}

enum AssignmentRuleMode {
  ROUND_ROBIN
  TERRITORY
  CAPACITY
}

model AssignmentRule {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean            @default(true)
  mode           AssignmentRuleMode @default(ROUND_ROBIN)
  slaMinutes     Int                @default(60)
  memberIds      String[]
  cursor         Int                @default(0)
  // TERRITORY mode only: lowercased territory name -> employeeId, e.g.
  // { "north": "<employeeId>", "south": "<employeeId>" }. Leads whose
  // territory has no entry here fall back to round robin across memberIds.
  territoryMap   Json?
  // CAPACITY mode only: max open (NEW/CONTACTED/QUALIFIED) leads a member
  // may hold before they're skipped. Null means unlimited.
  maxOpenLeads   Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, isActive])
  @@map("assignment_rules")
}

enum QualityAuditStatus {
  DRAFT
  PUBLISHED
}

// A reusable scoring template (e.g. "Call Quality", "Chat Handling"),
// authored by Manager+. Draft results scored against a definition are never
// shown to the subject employee — only once a QualityAuditResult reaches
// PUBLISHED.
model QualityAuditDefinition {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  // Ordered scoring sections, each with its own criteria:
  // [{ id, name, maxScore, criteria: [{ id, label, maxScore }] }]
  sections       Json
  isActive       Boolean      @default(true)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  results QualityAuditResult[]

  @@index([organizationId, isActive])
  @@map("quality_audit_definitions")
}

// One scored review of one employee against one definition, optionally
// linked to the record it was scored from (a specific Assignment/Lead/
// Opportunity). DRAFT until the reviewer publishes it; the employee can
// only ever see PUBLISHED results, and only their own (or their
// scope-authorized subordinates', for a reviewer).
model QualityAuditResult {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  definitionId   String
  definition     QualityAuditDefinition @relation(fields: [definitionId], references: [id])
  employeeId     String
  employee       Employee           @relation("QualityAuditSubject", fields: [employeeId], references: [id])
  reviewerId     String
  reviewer       Employee           @relation("QualityAuditReviewer", fields: [reviewerId], references: [id])
  referenceType  String?
  referenceId    String?
  overallScore   Int
  // Mirrors the definition's sections shape, with scores filled in:
  // [{ sectionId, score, criteria: [{ criteriaId, score, note }] }]
  sectionScores  Json
  feedback       String?
  status         QualityAuditStatus @default(DRAFT)
  acknowledgedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, employeeId, status])
  @@index([organizationId, reviewerId])
  @@map("quality_audit_results")
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowRunStatus {
  IN_PROGRESS
  COMPLETED
}

// A guided step-by-step procedure (helpdesk runbook, onboarding checklist,
// escalation flow) an employee can run themselves. Employees only ever see
// PUBLISHED definitions.
model WorkflowDefinition {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  tags           String[]
  version        Int            @default(1)
  status         WorkflowStatus @default(DRAFT)
  // Ordered steps: [{ id, title, body, fields: [{ id, label, type, required }] }]
  steps          Json
  ownerId        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  runs WorkflowRun[]

  @@index([organizationId, status])
  @@map("workflow_definitions")
}

// One employee's in-progress or completed pass through a WorkflowDefinition.
model WorkflowRun {
  id                   String            @id @default(uuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id])
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  employeeId           String
  employee             Employee          @relation(fields: [employeeId], references: [id])
  currentStepIndex     Int               @default(0)
  answers              Json              @default("{}")
  status               WorkflowRunStatus @default(IN_PROGRESS)
  startedAt            DateTime          @default(now())
  completedAt          DateTime?

  @@index([organizationId, employeeId, status])
  @@map("workflow_runs")
}
