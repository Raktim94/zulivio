generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER_OWNER
  COMPANY_ADMIN
  SALES_HEAD
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  ON_LEAVE
  SEPARATED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  FOLLOW_UP
  BLOCKED
  COMPLETED
  CANCELED
}

enum AttendanceEventType {
  WORKING
  ON_BREAK
  LOGGED_OUT
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees      Employee[]
  assignments    Assignment[]
  workSessions   WorkSession[]
  documents      KnowledgeDocument[]
  tips           Tip[]
  auditEvents    AuditEvent[]
  leads          Lead[]
  pipelines      Pipeline[]
  opportunities  Opportunity[]
  assignmentRules AssignmentRule[]

  @@map("organizations")
}

model Employee {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  employeeNumber   String
  fullName         String
  email            String
  passwordHash     String
  role             Role              @default(EMPLOYEE)
  department       String?
  employmentStatus EmploymentStatus  @default(ACTIVE)
  mustChangePassword Boolean         @default(true)
  managerId        String?
  manager          Employee?         @relation("EmployeeManager", fields: [managerId], references: [id])
  reports          Employee[]        @relation("EmployeeManager")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  separatedAt      DateTime?

  sessions             Session[]
  assignmentsOwned     Assignment[]        @relation("AssignmentOwner")
  assignmentsCreated   Assignment[]        @relation("AssignmentCreatedBy")
  workSessions         WorkSession[]
  trainingResults      TrainingResult[]
  tipAcknowledgements  TipAcknowledgement[]
  leadsOwned           Lead[]              @relation("LeadOwner")
  leadsCreated         Lead[]              @relation("LeadCreatedBy")
  opportunitiesOwned   Opportunity[]       @relation("OpportunityOwner")
  opportunitiesCreated Opportunity[]       @relation("OpportunityCreatedBy")

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, email])
  @@index([organizationId, employmentStatus])
  @@map("employees")
}

model Session {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  @@index([employeeId])
  @@map("sessions")
}

model Assignment {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  assignmentNumber Int
  title          String
  description    String?
  status         AssignmentStatus  @default(ASSIGNED)
  priority       String            @default("normal")
  ownerId        String?
  owner          Employee?         @relation("AssignmentOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      Employee          @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  dueAt          DateTime?
  outcome        String?
  outcomeNotes   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?

  events AssignmentEvent[]

  @@unique([organizationId, assignmentNumber])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@map("assignments")
}

model AssignmentEvent {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  fromStatus   AssignmentStatus?
  toStatus     AssignmentStatus
  actorId      String
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([assignmentId])
  @@map("assignment_events")
}

model WorkSession {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  startedAt      DateTime     @default(now())
  endedAt        DateTime?

  breaks Break[]

  @@index([organizationId, employeeId, startedAt])
  @@map("work_sessions")
}

model Break {
  id            String       @id @default(uuid())
  workSessionId String
  workSession   WorkSession  @relation(fields: [workSessionId], references: [id])
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  reason        String?

  @@index([workSessionId])
  @@map("breaks")
}

model KnowledgeDocument {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  title          String
  description    String?
  category       String?
  status         DocumentStatus @default(DRAFT)
  storageKey     String
  fileName       String
  mimeType       String
  sizeBytes      Int
  version        Int            @default(1)
  ownerId        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  trainingAssignments TrainingAssignment[]

  @@index([organizationId, status])
  @@map("knowledge_documents")
}

model TrainingAssignment {
  id         String            @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id])
  targetRole Role?
  targetEmployeeId String?
  dueAt      DateTime?
  createdAt  DateTime          @default(now())

  results TrainingResult[]

  @@map("training_assignments")
}

model TrainingResult {
  id                   String              @id @default(uuid())
  trainingAssignmentId String
  trainingAssignment   TrainingAssignment  @relation(fields: [trainingAssignmentId], references: [id])
  employeeId           String
  employee             Employee            @relation(fields: [employeeId], references: [id])
  acknowledgedAt       DateTime?
  documentVersion      Int

  @@unique([trainingAssignmentId, employeeId])
  @@map("training_results")
}

model Tip {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  body           String
  linkedDocumentId String?
  targetRole     Role?
  targetDepartment String?
  publishAt      DateTime     @default(now())
  createdById    String
  createdAt      DateTime     @default(now())

  acknowledgements TipAcknowledgement[]

  @@index([organizationId, publishAt])
  @@map("tips")
}

model TipAcknowledgement {
  id         String   @id @default(uuid())
  tipId      String
  tip        Tip      @relation(fields: [tipId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  acknowledgedAt DateTime @default(now())

  @@unique([tipId, employeeId])
  @@map("tip_acknowledgements")
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fullName       String
  email          String?
  phone          String?
  company        String?
  source         String?
  status         LeadStatus   @default(NEW)
  ownerId        String?
  owner          Employee?    @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      Employee     @relation("LeadCreatedBy", fields: [createdById], references: [id])
  notes          String?
  territory      String?
  respondBySlaAt DateTime?
  firstRespondedAt DateTime?
  convertedOpportunityId String?  @unique
  convertedOpportunity   Opportunity? @relation("LeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  opportunities  Opportunity[] @relation("OpportunityFromLead")

  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@map("leads")
}

model Pipeline {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  isDefault      Boolean        @default(false)
  createdAt      DateTime       @default(now())

  stages         PipelineStage[]
  opportunities  Opportunity[]

  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id])
  name        String
  sortOrder   Int
  probability Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)

  opportunities Opportunity[]

  @@index([pipelineId, sortOrder])
  @@map("pipeline_stages")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum ForecastCategory {
  PIPELINE
  BEST_CASE
  COMMITTED
  OMITTED
}

model Opportunity {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  pipelineId     String
  pipeline       Pipeline          @relation(fields: [pipelineId], references: [id])
  stageId        String
  stage          PipelineStage     @relation(fields: [stageId], references: [id])
  title          String
  company        String?
  amountMinor    Int               @default(0)
  currency       String            @default("INR")
  leadId         String?
  fromLead       Lead?             @relation("OpportunityFromLead", fields: [leadId], references: [id])
  ownerId        String?
  owner          Employee?         @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      Employee          @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  expectedCloseDate DateTime?
  status         OpportunityStatus @default(OPEN)
  lossReason     String?
  forecastCategory ForecastCategory @default(PIPELINE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  stageChangedAt DateTime          @default(now())

  convertedFromLead Lead? @relation("LeadConvertedOpportunity")
  events         OpportunityEvent[]
  forecastAdjustments ForecastAdjustment[]

  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, stageId])
  @@map("opportunities")
}

model OpportunityEvent {
  id            String       @id @default(uuid())
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id])
  fromStageId   String?
  toStageId     String
  actorId       String
  reason        String?
  createdAt     DateTime     @default(now())

  @@index([opportunityId])
  @@map("opportunity_events")
}

model ForecastAdjustment {
  id                  String      @id @default(uuid())
  organizationId      String
  opportunityId       String
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id])
  actorId             String
  previousCategory    ForecastCategory
  newCategory         ForecastCategory
  previousAmountMinor Int
  newAmountMinor      Int
  reason              String?
  createdAt           DateTime    @default(now())

  @@index([organizationId, opportunityId])
  @@map("forecast_adjustments")
}

enum AssignmentRuleMode {
  ROUND_ROBIN
  TERRITORY
  CAPACITY
}

model AssignmentRule {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean            @default(true)
  mode           AssignmentRuleMode @default(ROUND_ROBIN)
  slaMinutes     Int                @default(60)
  memberIds      String[]
  cursor         Int                @default(0)
  // TERRITORY mode only: lowercased territory name -> employeeId, e.g.
  // { "north": "<employeeId>", "south": "<employeeId>" }. Leads whose
  // territory has no entry here fall back to round robin across memberIds.
  territoryMap   Json?
  // CAPACITY mode only: max open (NEW/CONTACTED/QUALIFIED) leads a member
  // may hold before they're skipped. Null means unlimited.
  maxOpenLeads   Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, isActive])
  @@map("assignment_rules")
}
