# Copy to .env and fill in real values before running `docker compose up --build`.
# Generate strong secrets with: openssl rand -base64 32

# Postgres password shared by postgres/migrate/backend. Required — compose
# refuses to start without it (see compose.yaml's ${POSTGRES_PASSWORD:?...}).
POSTGRES_PASSWORD=

# Public origin the browser uses to reach the web app; backend CORS is
# locked to this origin.
FRONTEND_ORIGIN=http://localhost:3100

# Host port the web app is published on.
HOST_PORT=3100

# Set to "true" to permanently disable the /api/v1/bootstrap self-service
# organization-creation endpoint (e.g. once your single organization is set
# up and you never need a second tenant on this instance).
BOOTSTRAP_DISABLED=false

# Optional: Google Sheets live import/export. Create a Google Cloud service
# account, enable the Sheets API, and share your target spreadsheet with
# the service account's email. Leave blank to keep the integration
# disabled — the app works fully without it (CSV import/export still works).
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Used only by `pnpm db:seed` / `docker compose exec backend` seeding —
# never baked into the image or committed.
SEED_MASTER_OWNER_PASSWORD=
